{
  "schemaVersion": 2,
  "logRoots": {
    "claudeCode": ["~/.claude/projects"],
    "antigravity": ["~/.gemini/antigravity/brain"],
    "codex": ["~/.codex/sessions"],
    "opencode": ["~/.local/share/opencode"]
  },
  "sessionIndexRoots": {
    "claudeCode": ["~/Library/Application Support/Claude/claude-code-sessions"],
    "antigravity": ["~/.gemini/antigravity/annotations"],
    "codex": [],
    "opencode": []
  },
  "usage": {
    "timeZone": "system"
  },
  "liveView": {
    "openWithinSeconds": 1800
  },
  "cache": {
    "fullMissMinContextTokens": 20000,
    "hitToleranceTokens": 1024,
    "survivedMinCacheReadShare": 0.75,
    "lifetimeBandEdgesSeconds": [60, 300, 900, 1800, 3600, 7200, 21600, 86400],
    "minLifetimeObservations": 20,
    "declaredLifetimeSeconds": {
      "claudeCode": {},
      "antigravity": {},
      "codex": {},
      "opencode": {}
    },
    "referenceLifetimeSeconds": {
      "claudeCode": 300,
      "antigravity": 300,
      "codex": 300,
      "opencode": 300
    }
  },
  "models": {
    "assumed": {}
  },
  "rules": {
    "freshSession": { "minSessions": 5 },
    "sessionAdvice": {
      "minCompactions": 5,
      "minSessions": 5,
      "contextBandEdgesTokens": [50000, 100000, 200000, 500000],
      "recentTurnsWindow": 5,
      "weights": {
        "cacheRead": 0.1,
        "inputUncached": 1,
        "cacheWrite": 1.25,
        "output": 5
      }
    }
  },
  "ui": {
    "pollIntervalSeconds": 5,
    "usageRangesDays": [7, 30],
    "subagentRowsShown": 10
  }
}
